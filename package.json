{
  "name": "postalpulse-electron",
  "version": "0.1.3",
  "description": "MeldPOST Express - Automated USPS self-service shipping kiosk",
  "main": "./out/main/index.js",
  "author": "meldCX",
  "homepage": "https://meldcx.com",
  "scripts": {
    "dev": "npm run dev:booking",
    "dev:booking": "cross-env APP_VARIANT=booking electron-vite dev",
    "dev:lodgement": "cross-env APP_VARIANT=lodgement electron-vite dev",
    "build": "electron-vite build",
    "build:booking": "cross-env APP_VARIANT=booking electron-vite build",
    "build:lodgement": "cross-env APP_VARIANT=lodgement electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack:booking": "npm run build:booking && electron-builder --config electron-builder.booking.yml --dir",
    "build:unpack:lodgement": "npm run build:lodgement && electron-builder --config electron-builder.lodgement.yml --dir",
    "build:win:booking": "npm run build:booking && electron-builder --config electron-builder.booking.yml --win nsis --x64",
    "build:win:booking:arm64": "npm run build:booking && electron-builder --config electron-builder.booking.yml --win nsis --arm64",
    "build:win:booking:all": "npm run build:booking && electron-builder --config electron-builder.booking.yml --win nsis --x64 --arm64",
    "build:win:lodgement": "npm run build:lodgement && electron-builder --config electron-builder.lodgement.yml --win nsis --x64",
    "build:win:lodgement:arm64": "npm run build:lodgement && electron-builder --config electron-builder.lodgement.yml --win nsis --arm64",
    "build:win:lodgement:all": "npm run build:lodgement && electron-builder --config electron-builder.lodgement.yml --win nsis --x64 --arm64",
    "build:mac:booking": "npm run build:booking && electron-builder --config electron-builder.booking.yml --mac",
    "build:mac:lodgement": "npm run build:lodgement && electron-builder --config electron-builder.lodgement.yml --mac",
    "build:linux:booking": "npm run build:booking && electron-builder --config electron-builder.booking.yml --linux",
    "build:linux:lodgement": "npm run build:lodgement && electron-builder --config electron-builder.lodgement.yml --linux",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "electron-store": "^8.2.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.3.0",
    "react-simple-keyboard": "^3.8.209"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "cross-env": "^7.0.3",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "eslint": "^9.22.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.2",
    "vite": "^6.2.4"
  }
}
